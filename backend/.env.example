# --- Application ---
APP_NAME=Dark Kitchen Mafia OS
APP_URL=http://localhost:5173
DEBUG=true

# --- MySQL (optional) ---
# Leave DB_PASSWORD as the placeholder below and the app will automatically
# use a local SQLite file (backend/darkkitchen.db) instead — zero setup,
# no MySQL needed. Fill in a real password here to switch to MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=darkkitchen_db
DB_USER=root
DB_PASSWORD=231141
# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
